# ==============================================================================
# SKHD CONFIGURATION
# ==============================================================================

# Custom quarter rotation (preserved)
ctrl - i : ~/.config/yabai/cycle-quarter.sh

# Toggle Layout: BSP (automatic tiling) <-> Float (manual/rectangle mode)
# 'alt' is the Option (⌥) key
alt - space : ~/.config/yabai/toggle-layout.sh

# Balance all windows in BSP space
alt - b : yabai -m space --balance

# ------------------------------------------------------------------------------
# Direct Window Focus (alt / option + 1 .. 9)
# Windows sorted top-to-bottom, left-to-right (1 = top-left window, 2, 3...)
# ------------------------------------------------------------------------------
alt - 1 : ~/.config/yabai/focus-window.sh 0
alt - 2 : ~/.config/yabai/focus-window.sh 1
alt - 3 : ~/.config/yabai/focus-window.sh 2
alt - 4 : ~/.config/yabai/focus-window.sh 3
alt - 5 : ~/.config/yabai/focus-window.sh 4
alt - 6 : ~/.config/yabai/focus-window.sh 5
alt - 7 : ~/.config/yabai/focus-window.sh 6
alt - 8 : ~/.config/yabai/focus-window.sh 7
alt - 9 : ~/.config/yabai/focus-window.sh 8

# ------------------------------------------------------------------------------
# Rectangle Replacement Bindings (works in both float and bsp)
# ------------------------------------------------------------------------------

# Left Half / Right Half
shift + cmd - j : ~/.config/yabai/window-place.sh left-half
shift + cmd - k : ~/.config/yabai/window-place.sh right-half

# Top Half / Bottom Half (0x2B is ,, 0x2F is .)
shift + cmd - 0x2B : ~/.config/yabai/window-place.sh top-half
shift + cmd - 0x2F : ~/.config/yabai/window-place.sh bottom-half

# Maximize (works reliably in both float and bsp)
shift + cmd - up : ~/.config/yabai/window-place.sh maximize

# Maximize Height
ctrl + alt + shift - up : ~/.config/yabai/window-place.sh maximize-height

# Center
ctrl + alt - c : ~/.config/yabai/window-place.sh center

# Restore (toggle zoom or balance)
ctrl + alt - backspace : yabai -m window --toggle zoom-fullscreen 2>/dev/null || yabai -m space --balance

# Make Smaller / Make Larger / Minimum Size
shift + cmd - down : yabai -m window --resize bottom:0:-40 2>/dev/null || yabai -m window --resize top:0:40 2>/dev/null || yabai -m window --resize right:-40:0
ctrl + alt - 0x18  : yabai -m window --resize bottom:0:40 2>/dev/null || yabai -m window --resize top:0:-40 2>/dev/null || yabai -m window --resize right:40:0 # 0x18 is =
shift + cmd - 0x2A : ~/.config/yabai/window-place.sh smallest # 0x2A is \

# First Third / Center Third / Last Third / First Two Thirds / Last Two Thirds
ctrl + alt - d  : ~/.config/yabai/window-place.sh first-third
ctrl + alt - f  : ~/.config/yabai/window-place.sh center-third
shift + cmd - l : ~/.config/yabai/window-place.sh last-third
shift + cmd - u : ~/.config/yabai/window-place.sh first-two-thirds
shift + cmd - i : ~/.config/yabai/window-place.sh last-third
